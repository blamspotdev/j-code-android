<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole point of this fixture: an AppCompat theme, which AppCompatDelegate verifies by
         reading `windowActionBar` off the activity's own theme. If the container leaves the
         activity themed against JCode's resource table, that attribute is absent and AppCompat
         refuses to inflate with "You need to use a Theme.AppCompat theme (or descendant)". -->
    <style name="Theme.AppCompatGuest" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF101418</item>
        <item name="colorAccent">#FF7FD1AE</item>
    </style>
</resources>
