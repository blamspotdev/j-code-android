<?xml version="1.0" encoding="utf-8"?>
<!-- The virtual device's Settings app.

     A device you can only configure from outside itself is a device with a piece missing. The
     hardware bench and Manage permissions are JCode's screens, in JCode's window, reached by the
     person driving the IDE — which is right for JCode and no use at all to somebody looking at the
     device, or to an agent driving it through `input tap`, or to an app that sends
     ACTION_MANAGE_APPLICATIONS and expects something to answer.

     It changes real settings, through a provider the container publishes for it: the same ones the
     bench writes, in the same file, with the same effect on a running guest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.blamspot.jcode.vdevice.settings">

    <application
        android:label="Settings"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Settings"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The settings intents an app sends when it wants to send somebody here rather than
                 explain what to go and change. -->
            <intent-filter>
                <action android:name="android.settings.SETTINGS" />
                <action android:name="android.settings.WIFI_SETTINGS" />
                <action android:name="android.settings.WIRELESS_SETTINGS" />
                <action android:name="android.settings.BLUETOOTH_SETTINGS" />
                <action android:name="android.settings.SOUND_SETTINGS" />
                <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
                <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
                <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
                <action android:name="android.settings.DEVICE_INFO_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
