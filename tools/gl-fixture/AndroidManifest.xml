<?xml version="1.0" encoding="utf-8"?>
<!-- A deliberately unambiguous GL test for the virtual device.

     Every real GL app tested so far has a setup flow, a licence check or a first-run wizard in the
     way, so "black screen" could always mean either "the container cannot composite a SurfaceView"
     or "this app has not drawn anything yet". This one draws a solid colour the instant its surface
     exists and nothing else, so the tab either shows the colour or the container has a real bug. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.blamspot.jcode.vdevice.glfixture">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="GL Fixture"
        android:icon="@android:drawable/ic_menu_gallery"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".GlActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
