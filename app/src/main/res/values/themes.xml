<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Startup theme used only for the system launch window. Android 11 and below use the centered
         layer-list icon; Android 12+ uses the platform splash attributes. -->
    <style name="Theme.JCode.Starting" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:colorBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>
    </style>

    <!-- Runtime app theme. Keep the dark window background so there is no white flash before Compose
         draws. Parent kept Light so any android-themed component is unchanged. -->
    <style name="Theme.JCode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:colorBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- What the built-in browser's WebView is handed, and the only reason these exist.

         A WebView decides what to report for `prefers-color-scheme` from `android:isLightTheme` on
         the context it was built with — not from the night bits of the configuration, and not from
         whatever the app happens to be painting. The runtime theme above is a Light parent (kept
         that way on purpose, so any android-themed component stays as it was), so every page in a
         dark workbench was being told the user prefers light and themed itself accordingly.

         Two themes rather than a night-qualified one: the workbench's own theme setting can differ
         from the device's, and this has to follow the workbench. -->
    <style name="Theme.JCode.Web.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
    </style>

    <style name="Theme.JCode.Web.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
