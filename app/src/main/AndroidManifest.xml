<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Held for the virtual device's guests, not for JCode itself.
         A guest runs under JCode's uid, so it holds JCode's permissions and no others — an app
         that merely asks whether it is online died on
         "ConnectivityService: Neither user 10211 nor current process has ACCESS_NETWORK_STATE"
         before drawing a frame. Measured on Ookla Speedtest.
         Every one of these is protection level *normal*: granted at install, no prompt, and none of
         them reaches user data. Camera, location and contacts are deliberately absent, so a guest
         that wants those still cannot have them, which is the line worth keeping between "runs the
         app" and "runs the app with the user's phone". The device offers a simulated camera and a
         simulated GPS in their place — see VirtualDevicePolicy. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app hand Android a "remove the old install" request after a migration. A normal
         permission, not a dangerous one: it grants nothing except the right to ASK — the system
         installer still shows its own confirmation and does the removal itself. Without it that
         request is refused outright ("does not have android.permission.REQUEST_DELETE_PACKAGES"). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- The installs a migration bundle can have come from. Android 11 filters package queries, so
         without naming them the app cannot tell whether the old install is still present after an
         import — and would offer to remove an app it cannot see, or fail to offer at all. Named
         explicitly rather than with QUERY_ALL_PACKAGES: these three are the only ones it ever asks
         about, and the broad permission is restricted on Play for good reason. -->
    <queries>
        <package android:name="dev.jcode" />
        <package android:name="dev.jcode.debug" />
        <package android:name="dev.jcode.beta" />
    </queries>

    <!-- The one dangerous permission held for the virtual device, and the only hardware a guest can
         be given for real: the microphone. Never granted by holding it — it is requested from the
         user at the moment an app on the device is switched to a real microphone in Manage
         permissions, and until that happens JCode does not have it and neither does any guest.
         Every other guest is offered a simulated microphone, which records silence. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "All files access": raw file-path access to /storage/emulated/0/JCode (workspace root and
         proot bind mounts). Legacy storage permissions stopped working at targetSdk 30+; granted
         via the system settings toggle, checked with Environment.isExternalStorageManager(). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- In-app updater: install a downloaded release APK from Settings → About → Update. The system
         still shows its install confirmation / Play Protect scan for an unrecognized build; a
         same-signature self-update can be silent. Gated at runtime by canRequestPackageInstalls(). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (targetSdk 30+): the "Open web previews in" picker enumerates
         installed browsers via queryIntentActivities(ACTION_VIEW http/https). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:icon="${appIcon}"
        android:roundIcon="${appIconRound}"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.JCode.Starting">

        <!-- hardwareAccelerated=false so the user's Settings toggle governs it: MainActivity enables
             acceleration via FLAG_HARDWARE_ACCELERATED (window level can only ENABLE, never disable,
             so the manifest default must be off for an opt-out to be possible). Default pref is ON. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BackendService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="interactive_terminal_and_build_runner" />
        </service>

        <!-- Exposes the app-private ext4 projects tree to the system Files app / SAF pickers as a
             browsable "JCode Projects" root (files never leave ext4). Guarded by MANAGE_DOCUMENTS,
             which only DocumentsUI holds; authority is per-variant so debug/beta/release coexist. -->
        <provider
            android:name=".provider.ProjectsDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The virtual device's own storage, as content:// URIs. A picker hands an app a URI rather
             than a path, so without this the device's filesystem would be one a guest could be told
             about and not read. DocumentsProvider refuses to start unless it is exported, grants URI
             permissions and is guarded by MANAGE_DOCUMENTS — which only DocumentsUI holds, so the
             audience is the person (through the Files app, the one way onto the device that is not
             `adb push`) and the guest, which reaches it because a provider never permission-checks
             its own uid. -->
        <provider
            android:name=".vdevice.VirtualStorageProvider"
            android:authorities="${applicationId}.vdevice.files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- How the device's own Settings app reads and changes the device's settings. Not exported:
             the only caller is a guest, and a guest runs in this app's own process under this app's
             own uid, so it reaches the provider without the provider being open to the phone. -->
        <provider
            android:name=".vdevice.VirtualSettingsProvider"
            android:authorities="${applicationId}.vdevice.settings"
            android:exported="false" />

        <!-- Receives PackageInstaller session status for the in-app updater (see AppUpdateInstaller).
             Not exported: it only handles the PendingIntent this app hands to its own commit(). -->
        <receiver
            android:name=".AppInstallReceiver"
            android:exported="false" />

        <!-- Virtual device (dev.jcode.vdevice): a declared activity the container never launches.
             A guest activity belongs to a package the system has never heard of, so there is no
             ActivityInfo to build one from; this stub is that template, and nothing else. It is
             declared in the :guest process so the guest gets its own ART heap and framework hooks
             and cannot corrupt the IDE, and configChanges is deliberately broad so a guest handles
             configuration changes itself rather than being relaunched. -->
        <activity
            android:name=".vdevice.GuestActivity"
            android:process=":guest"
            android:exported="false"
            android:launchMode="standard"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|layoutDirection|fontScale|density|colorMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- The app-sandbox editor tab's half of the container: the workbench binds this to have the
             guest built window-less and composited into a SurfaceView (see EmbeddedGuest). It shares
             the stubs' :guest process on purpose — the hooks and the guest's heap must stay out of
             the IDE — and unbinding it is what tears a session down, since nothing else keeps the
             process alive. -->
        <service
            android:name=".vdevice.GuestSessionService"
            android:process=":guest"
            android:exported="false" />

    </application>

</manifest>
