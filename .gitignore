# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# The virtual device's built-in apps are shipped, not built here: they are assets JCode installs
# onto the device on every start (see VirtualDeviceApps.installBuiltIns). Their sources live in
# tools/, but the signed APK is an input to the app's build, so it has to be tracked.
!app/src/main/assets/vdevice/*.apk

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof
AGENTS.md

# Rust build outputs (native FFI modules)
native/*/rust/target/

# Local scratch (screenshots, junk)
temp/
/builds/
.claude/
.kotlin/
plans/
build-warnings.txt
wd.xml
# Loose screenshots/images at the repo root (keep README assets under docs/)
/*.png
/*.jpg
/*.jpeg
/*.webp
